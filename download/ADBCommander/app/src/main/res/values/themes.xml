<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ADBCommander" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Transparent theme for the share popup so the dialog appears over the previous app -->
    <style name="Theme.ADBCommander.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
